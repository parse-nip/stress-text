{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "telegram-wrapped",
  "compatibility_date": "2026-07-22",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    {
      "pattern": "wrapped.popped.dev",
      "custom_domain": true
    }
  ],
  "workers_dev": true
}
